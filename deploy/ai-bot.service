[Unit]
Description=AI News — 飞书 Bot 常驻服务
Documentation=https://github.com/ShawShannon24/aiNews
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/npx tsx /opt/aiNews/src/bot/index.ts
WorkingDirectory=/opt/aiNews
EnvironmentFile=/etc/ai-news.env
Environment=NODE_ENV=production
# 3000 已被 health-bot 占用，Bot 改用 3001（Nginx 反代对应调整）
Environment=PORT=3001
Environment=PATH=/usr/local/bin:/usr/bin:/bin
StandardOutput=journal
StandardError=journal
User=ainews
# 部署前需创建 ainews 用户：
#   sudo useradd -r -s /usr/sbin/nologin ainews
#   sudo chown -R ainews:ainews /opt/aiNews /var/log/ai-news
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
